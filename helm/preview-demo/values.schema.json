{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "prNumber": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,9}$"
    },
    "commitSha": {
      "type": "string",
      "minLength": 1
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "namespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$"
        }
      }
    }
  }
}
