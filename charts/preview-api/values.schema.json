{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["rollingUpdate"],
  "properties": {
    "rollingUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSurge", "maxUnavailable"],
      "properties": {
        "maxSurge": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "maxUnavailable": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      },
      "anyOf": [
        { "properties": { "maxSurge": { "minimum": 1 } } },
        { "properties": { "maxUnavailable": { "minimum": 1 } } }
      ]
    }
  }
}
